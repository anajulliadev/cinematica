{
  "name": "cinematica",
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "cd backend && python -m uvicorn app.main:app --reload --port 8000",
    "dev:web": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "cd backend && python -m uvicorn app.main:app --port 8000",
    "test": "cd backend && python -m pytest"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
